# ── Docker Compose environment ───────────────────────────────────────────────
# Copy this file to .env (project root) and fill in real values.
# This is separate from backend/.env which is used for local (non-Docker) dev.

# MySQL root password — used by both the db container and the DATABASE_URL below.
# Choose a strong password without % or # (they need URL-encoding in DATABASE_URL).
DB_ROOT_PASSWORD=Phamysql#145

# Full asyncmy connection string. Replace <password> with the same value as
# DB_ROOT_PASSWORD above. Note the host is "db" (the compose service name).
DATABASE_URL=mysql+asyncmy://root:Phamysql#145
@db:3306/mpscorer

# LLM providers — leave GROQ_API_KEY empty to rely on Ollama only
GROQ_API_KEY=
DATAGOV_API_KEY=

# "groq" (cloud) or "ollama" (local — requires Ollama running on the host)
LLM_PROVIDER=groq

# If using Ollama locally, host.docker.internal reaches the host machine from a container
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

DEBUG=false
