FROM python:3.11-slim

WORKDIR /app

# System deps for asyncmy (MySQL client) and lxml
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps before copying source for layer-cache efficiency
COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY backend/ ./backend/

# Ensure runtime directories exist (data/cache is volume-mounted at runtime)
RUN mkdir -p data/cache/myneta logs

COPY backend/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

ENTRYPOINT ["/entrypoint.sh"]
